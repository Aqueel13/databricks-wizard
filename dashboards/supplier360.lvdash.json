{
 "datasets": [
  {
   "name": "kpis",
   "displayName": "Headline KPIs",
   "queryLines": [
    "SELECT\n  (SELECT count(*) FROM wizard.gold.supplier_360) AS suppliers,\n  (SELECT count(*) FROM wizard.gold.supplier_360 WHERE risk_band = 'high') AS high_risk,\n  (SELECT count(*) FROM wizard.gold.supplier_delivery_trend WHERE deteriorating) AS deteriorating,\n  (SELECT count(*) FROM wizard.gold.supplier_dq_scorecard WHERE has_issues) AS dq_issues,\n  (SELECT round(sum(spend_usd_12m) / 1e6, 1) FROM wizard.gold.spend_concentration) AS spend_12m_musd"
   ]
  },
  {
   "name": "concentration",
   "displayName": "Spend concentration (12 months)",
   "queryLines": [
    "SELECT category_name, spend_type, round(spend_usd_12m / 1e6, 2) AS spend_musd, suppliers, hhi,\n  round(100 * top1_share, 1) AS top1_pct, round(100 * top3_share, 1) AS top3_pct, concentration\nFROM wizard.gold.spend_concentration"
   ]
  },
  {
   "name": "ontime",
   "displayName": "On-time delivery by month",
   "queryLines": [
    "SELECT date_trunc('MONTH', received_date) AS month, round(100 * avg(CAST(on_time AS INT)), 1) AS on_time_pct,\n  round(avg(greatest(days_late, 0)), 1) AS avg_days_late, count(*) AS receipts\nFROM wizard.gold.fact_delivery WHERE received_date >= add_months(current_date(), -36) GROUP BY 1"
   ]
  },
  {
   "name": "deteriorating",
   "displayName": "Deteriorating suppliers",
   "queryLines": [
    "SELECT s.legal_name, s.country, round(100 * t.on_time_baseline, 1) AS on_time_before_pct,\n  round(100 * t.on_time_recent, 1) AS on_time_recent_pct, t.excess_days_late_increase AS extra_days_late, t.z_score, t.n_recent AS recent_receipts\nFROM wizard.gold.supplier_delivery_trend t JOIN wizard.gold.supplier_360 s USING (supplier_id) WHERE t.deteriorating"
   ]
  },
  {
   "name": "risk",
   "displayName": "Risk watchlist",
   "queryLines": [
    "SELECT legal_name, country, main_category, risk_band, risk_score, delivery_risk, compliance_risk,\n  concentration_risk, data_quality_risk, array_join(risk_drivers, '; ') AS drivers\nFROM wizard.gold.supplier_360 WHERE risk_band IN ('high', 'medium')"
   ]
  },
  {
   "name": "dq",
   "displayName": "Master data issues",
   "queryLines": [
    "SELECT issue, count(*) AS suppliers FROM wizard.gold.supplier_dq_scorecard LATERAL VIEW explode(issues) i AS issue GROUP BY issue"
   ]
  }
 ],
